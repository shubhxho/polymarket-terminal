# PostgreSQL connection string (PlanetScale Postgres, Neon, Supabase, local, …).
# Without it the database layer is a no-op: /api/signals still works, it just
# does not persist snapshots or logs. Add it and persistence switches on.
#
# Then apply the schema:  bun run db:migrate   (or  bun run db:push )
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
